event manager applet NCL-AP_Ports_C9115AX-Config authorization bypass
 event neighbor-discovery interface regexp Ethernet.* cdp add
 action 1.0 regexp "(C9115AX)" "$_nd_cdp_platform"
 action 2.0 if $_regexp_result eq "1"
 action 3.0  cli command "enable"
 action 4.0  cli command "config t"
 action 5.0  cli command "default interface $_nd_local_intf_name"
 action 5.1  cli command "int $_nd_local_intf_name"
 action 5.2  cli command "description WL-AP"
 action 5.3  cli command "switchport access vlan 801"
 action 5.4  cli command "switchport mode access"
 action 5.5  cli command "switchport nonegotiate"
 action 5.6  cli command "spanning-tree portfast"
 action 5.7  cli command "spanning-tree bpduguard enable"
 action 5.8  cli command "description $_nd_cdp_entry_name"
 action 6    cli command "end"
 action 6.1  cli command "write"
 action 6.2  syslog msg "EEM script configured AP port and saved config"
 action 7.0 end
