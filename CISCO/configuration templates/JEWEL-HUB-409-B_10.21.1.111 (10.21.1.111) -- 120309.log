^C
!
line con 0
 exec-timeout 60 0
 privilege level 15
 logging synchronous
 login authentication consoleport
 stopbits 1
line aux 0
line vty 0 4
 access-class allow_vty_in in
 exec-timeout 30 0
 privilege level 15
 authorization exec VTY_author
 logging synchronous
 login authentication VTY_authen
 transport input ssh
line vty 5 15
 access-class allow_vty_in in
 exec-timeout 30 0
 privilege level 15
 logging synchronous
 transport input ssh
!
ntp source Loopback0
ntp access-group peer allow_vty_in
ntp access-group serve allow_vty_in
ntp access-group serve-only allow_vty_in
ntp access-group query-only allow_vty_in
ntp server 10.21.0.1
ntp server 10.21.50.55
ntp server 10.21.49.55
